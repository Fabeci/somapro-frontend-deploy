# SPA Angular — toutes les routes inconnues sont servies par index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Les fichiers et dossiers existants sont servis tels quels
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tout le reste -> index.html (routage côté client)
  RewriteRule ^ index.html [L]
</IfModule>

# index.html ne doit jamais être mis en cache
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>

# Les bundles hashés peuvent être mis en cache longtemps
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
